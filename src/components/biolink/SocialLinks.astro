---
// SocialLinks component for displaying social media icons
import { Icon } from 'astro-icon/components';

interface SocialLink {
  platform: string;
  url: string;
  icon: string;
}

interface Props {
  links: SocialLink[];
}

const { links } = Astro.props;
---

<div class="flex justify-center gap-5 ">
  {
    links.map((link) => (
      <a 
        href={link.url} 
        target="_blank" 
        rel="noopener noreferrer"
        class="neo-button bg-theme-text dark:bg-theme-text hover:bg-theme-primary dark:hover:bg-theme-primary w-12 h-12 flex items-center justify-center p-0 rounded-lg"
        aria-label={`Visit ${link.platform}`}
      >
        <Icon name={link.icon} class="w-6 h-6 text-theme-surface dark:text-theme-surface" />
      </a>
    ))
  }
</div> 