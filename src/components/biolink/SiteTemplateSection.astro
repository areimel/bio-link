---
// SiteTemplateSection component - Template promotion section for developers
import LinkButton from './LinkButton.astro';

interface Props {
  headline: string;
  logo: string;
  templateName: string;
  description: string;
  linkButton: {
    title: string;
    url: string;
    icon?: string;
    modal?: string;
  };
}

const { headline, logo, templateName, description, linkButton } = Astro.props;
---

<div class="w-full neo-container p-6 mb-6 bg-theme-surface dark:bg-slate-800 text-theme-text dark:text-white">
  <div class="flex flex-col items-center ">
    
    <!-- Section Headline -->
    <h2 class="text-xl font-bold font-heading text-theme-text dark:text-white mb-6 tracking-tight max-w-sm mx-auto text-center" style="text-wrap: balance;">
      {headline}
    </h2>

    <!-- Template Name -->
    <!-- <h3 class="text-2xl font-bold font-heading text-theme-accent dark:text-theme-secondary mb-4 tracking-tight max-w-sm mx-auto" style="text-wrap: balance;">
      {templateName}
    </h3> -->
    
    <!-- Description -->
    <p class="text-sm font-mono font-semibold text-theme-text dark:text-white mb-6 tracking-tight max-w-sm mx-auto">
      {description}
    </p>

    <!-- Action Button -->
    <div class="w-full max-w-sm">
      <LinkButton 
        title={linkButton.title}
        url={linkButton.url}
        icon={linkButton.icon}
        modal={linkButton.modal}
      />
    </div>
    
  </div>
</div>