---
// SupportSection component - Buy Me Coffee and Patreon support section
import LinksList from './LinksList.astro';

interface Props {
  supportLinks: Array<{
    title: string;
    url: string;
    icon?: string;
  }>;
}

const { supportLinks } = Astro.props;
---

<div class="w-full neo-container p-6 bg-theme-surface dark:bg-slate-800 text-theme-text dark:text-white">
 
  <div class="w-full text-center">
    <h2 class="text-xl font-bold font-heading text-theme-text dark:text-white mb-2 tracking-tight max-w-sm mx-auto" style="text-wrap: balance;">
      Enjoy my work?
    </h2>
    <p class="text-sm font-mono font-semibold text-theme-text dark:text-white mb-4 tracking-tight max-w-sm mx-auto" style="text-wrap: balance;">
      You can follow and support me on the following channels:
    </p>

    <!-- Support Links -->
    <LinksList links={supportLinks} />
  </div>
</div>