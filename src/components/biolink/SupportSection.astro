---
// SupportSection component - Buy Me Coffee and Patreon support section
import LinkButton from './LinkButton.astro';
---

<div class="w-full neo-container p-6 bg-theme-surface dark:bg-slate-800 text-theme-text dark:text-white">
 
  <div class="w-full text-center">
    <h2 class="text-sm font-press-start text-theme-text dark:text-white mb-2 tracking-tight max-w-sm mx-auto" style="text-wrap: balance;">
      Enjoying my work?
    </h2>
    <p class="text-xs font-mono font-semibold text-theme-text dark:text-white mb-4 tracking-tight max-w-sm mx-auto" style="text-wrap: balance;">
      Feel free to support me on the following channels:
    </p>

    <!-- Buy Me A Coffee Button -->
    <LinkButton 
      title="Buy Me A Coffee" 
      icon='tabler:external-link' 
      url="https://buymeacoffee.com/alecreimel"
    />
    
    <div class="mb-2">-- or --</div>

    <LinkButton 
      title="Join My Patreon" 
      icon='tabler:external-link' 
      url="https://www.patreon.com/cw/ARDATechLab"
    />
  </div>
</div>