---
import { Icon } from 'astro-icon/components';
import LinkButton from './LinkButton.astro';
import Badge from '../common/Badge.astro';

interface Props {
  title: string;
  url: string;
  icon?: string;
  thumbnail?: string;
  description: string;
  technologies: string[];
  type: string;
}

const { title, url, icon, thumbnail, description, technologies, type } = Astro.props;
---

<div
  
  class="block w-full bg-theme-surface dark:bg-slate-800 neo-card p-4"
>
  <!-- Thumbnail Image -->
  <div class="w-full h-32 mb-3 bg-theme-secondary dark:bg-theme-primary rounded neo-border overflow-hidden flex items-center justify-center">
    {thumbnail ? (
      <img
        src={thumbnail}
        alt={`${title} thumbnail`}
        class="w-full h-full object-cover"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
    ) : (
      <div class="flex items-center justify-center w-full h-full">
        {icon && <Icon name={icon} class="w-12 h-12 text-theme-text dark:text-white" />}
      </div>
    )}
    <div class="hidden items-center justify-center w-full h-full">
      {icon && <Icon name={icon} class="w-12 h-12 text-theme-text dark:text-white" />}
    </div>
  </div>
  
  <!-- Header with Icon and Title -->
  <div class="flex items-center gap-3 mb-2">
    {icon && (
      <div class="flex-shrink-0">
        <Icon name={icon} class="w-6 h-6 text-theme-accent dark:text-theme-secondary" />
      </div>
    )}
    <h3 class="font-press-start text-xs text-theme-text dark:text-white leading-tight">
      {title}
    </h3>
  </div>
  
  <!-- Project Type Badge -->
  <div class="mb-3">
    <Badge text={type} variant="primary" size="sm" />
  </div>
  
  <!-- Description -->
  <p class="text-sm text-theme-text dark:text-gray-300 mb-3 leading-relaxed font-mono">
    {description}
  </p>
  
  <!-- Technologies -->
  {technologies && technologies.length > 0 && (
    <div class="mb-3">
      <div class="flex flex-wrap gap-1">
        {technologies.map(tech => (
          <Badge text={tech} variant="accent" size="sm" />
        ))}
      </div>
    </div>
  )}
  
  <!-- Link Arrow -->
  <div class="flex ">
    <LinkButton 
      title="View Project" 
      icon='tabler:external-link' 
      url={url}
    />
  </div>
</div>