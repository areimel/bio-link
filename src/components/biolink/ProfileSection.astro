---
// ProfileSection component for displaying user profile information
import SocialLinks from './SocialLinks.astro';
import LinksList from './LinksList.astro';
import LinkButton from './LinkButton.astro';

interface Props {
  name: string;
  title: string;
  subtitle: string;
  avatar: string;
  socialLinks: Array<{
    platform: string;
    url: string;
    icon: string;
  }>;
  profileLinks: Array<{
    title: string;
    url: string;
    icon?: string;
    modal?: string;
  }>;
}

const { name, title, subtitle, avatar, socialLinks, profileLinks } = Astro.props;
---

<div class="flex flex-col items-center text-center px-4 pb-12 pt-6 relative neo-container mb-6">
  <!-- Dark/Light Mode Toggle -->
  <!-- <div class="absolute top-2 right-2">
    <ToggleTheme 
      iconClass="w-6 h-6 text-theme-accent dark:text-theme-secondary" 
      class="hover:bg-theme-surface dark:hover:bg-slate-700 focus:ring-theme-primary dark:focus:ring-theme-accent-alt"
    />
  </div> -->

  <!-- Profile Avatar -->
  <div class="w-48 h-48 mb-6 overflow-hidden rounded-full neo-border border-theme-accent dark:border-theme-secondary">
    <img 
      src={avatar} 
      alt={`${name}'s profile picture`} 
      class="w-full h-full object-cover"
    />
  </div>
  
  <!-- Profile Info -->
  <h1 class="text-lg font-heading text-theme-text dark:text-white leading-relaxed">{name}</h1>
  <h2 class="text-sm font-heading text-theme-accent dark:text-theme-secondary mb-4 tracking-tight max-w-sm mx-auto" style="text-wrap: balance;" >{title}</h2>
  <p class="text-xs font-mono font-semibold text-theme-text dark:text-white mb-4 tracking-tight max-w-sm mx-auto" style="text-wrap: balance;" >{subtitle}</p>
  <!-- <p class="text-sm text-default dark:text-muted max-w-md mb-4">{description}</p> -->
  <SocialLinks links={socialLinks} />
  
  <!-- Profile Links -->
  <div class="w-full">
    <LinksList links={profileLinks} />
  </div>
  
  <div class="border-b-4 border-black w-full mb-6 mt-2"></div>
  
  <div class="w-full">
    <h2 class="text-sm font-heading text-theme-text dark:text-white mb-2 tracking-tight max-w-sm mx-auto" style="text-wrap: balance;" >
      Enjoying my work?
    </h2>
    <p class="text-xs font-mono font-semibold text-theme-text dark:text-white mb-4 tracking-tight max-w-sm mx-auto" style="text-wrap: balance;" >
      Feel free to support me on the following channels:
    </p>

    <!-- Buy Me A Coffee Button -->
    <LinkButton 
      title="Buy Me A Coffee" 
      icon='tabler:external-link' 
      url="https://buymeacoffee.com/alecreimel"
    />
    
    <div class="mb-2">-- or --</div>

    <LinkButton 
      title="Join My Patreon" 
      icon='tabler:external-link' 
      url="https://www.patreon.com/cw/ARDATechLab"
    />
  </div>
</div> 