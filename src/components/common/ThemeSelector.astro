---
// Theme selector dropdown component
import { themes, defaultTheme } from '~/config/themes';

const availableThemes = themes;
const currentTheme = defaultTheme; // Will be updated client-side
---

<div class="theme-selector relative">
  <select 
    class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
    aria-label="Select theme"
    data-theme-selector
  >
    {availableThemes.map((theme) => (
      <option 
        value={theme.id} 
        selected={theme.id === currentTheme}
      >
        {theme.name}
      </option>
    ))}
  </select>
</div>

<script is:inline>
  // Client-side theme selection for themes page
  document.addEventListener('DOMContentLoaded', () => {
    const selector = document.querySelector('[data-theme-selector]');
    
    if (selector && window.themeUtils) {
      // Detect current theme from HTML class
      let currentTheme = 'electric-surge'; // default
      const availableThemes = window.themeUtils.getAvailableThemes();
      
      for (const theme of availableThemes) {
        if (theme.class && document.documentElement.classList.contains(theme.class)) {
          currentTheme = theme.id;
          break;
        }
      }
      
      selector.value = currentTheme;
      
      // Listen for theme changes
      selector.addEventListener('change', (e) => {
        const themeId = e.target.value;
        window.themeUtils.applyTheme(themeId);
      });
    }
  });
</script>