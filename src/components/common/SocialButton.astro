---
// SocialButton component - Specialized button for social media links
import { Icon } from 'astro-icon/components';

interface Props {
  platform: string;
  url: string;
  icon: string;
}

const { platform, url, icon } = Astro.props;
---

<a 
  href={url} 
  target="_blank" 
  rel="noopener noreferrer"
  class="neo-button bg-theme-text hover:bg-theme-primary w-12 h-12 flex items-center justify-center p-0 rounded-lg"
  aria-label={`Visit ${platform}`}
>
  <Icon name={icon} class="w-6 h-6 text-theme-surface" />
</a>