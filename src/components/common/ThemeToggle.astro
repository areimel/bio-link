---
// Multi-theme toggle component
import { themes, defaultTheme } from '~/config/themes';
import { Icon } from 'astro-icon/components';

export interface Props {
  label?: string;
  class?: string;
  iconClass?: string;
}

const {
  label = 'Toggle theme',
  class: className = 'text-muted hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center',
  iconClass = 'w-6 h-6',
} = Astro.props;

// Will be updated client-side
let currentTheme = defaultTheme;
---

<div class="theme-toggle-container">
  <button 
    type="button" 
    class={className} 
    aria-label={label}
    data-aw-toggle-theme
  >
    <Icon 
      name="tabler:palette" 
      class={iconClass} 
    />
  </button>
</div>

<script is:inline>
  // Client-side theme toggle
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButton = document.querySelector('[data-aw-toggle-theme]');
    
    if (toggleButton && window.themeUtils) {
      toggleButton.addEventListener('click', () => {
        // Toggle through all available themes
        window.themeUtils.toggleTheme();
        // No reload needed - theme updates immediately
      });
    }
  });
</script>