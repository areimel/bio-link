---
import '@fontsource-variable/inter';
import '@fontsource/kode-mono';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Kode Mono';
    --aw-font-mono: 'Courier Prime';

    /* Semantic theme colors (preserving VHS color values) */
    --aw-color-theme-secondary: #f7d959; /* Bright secondary accent */
    --aw-color-theme-primary: #f47f21; /* Main primary action color */
    --aw-color-theme-accent: #da3440; /* Vibrant accent/highlight */
    --aw-color-theme-accent-alt: #af375d; /* Alternative accent */
    --aw-color-theme-surface: #f2e2c8; /* Surface background */
    --aw-color-theme-text: rgb(68, 68, 68); /* Main text color */

    /* Main theme colors using semantic theme palette */
    --aw-color-primary: var(--aw-color-theme-accent);
    --aw-color-secondary: var(--aw-color-theme-secondary);
    --aw-color-accent: var(--aw-color-theme-accent-alt);
    
    --aw-color-text-heading: rgb(68, 68, 68); 
    --aw-color-text-default: rgb(56, 56, 56);
    --aw-color-text-muted: rgb(56, 56, 56 / 66%);
    --aw-color-bg-page: #f2e2c8; 

    /* Hyper-specific theme control variables */
    --aw-page-background: var(--aw-color-bg-page);
    --aw-section-background: var(--aw-color-theme-surface);
    --aw-link-button-background: #FFFFFF;
    --aw-link-button-text-color: var(--aw-color-theme-text);
    --aw-link-button-accent-color: var(--aw-color-theme-primary);
    --aw-social-button-background: var(--aw-color-theme-text);
    --aw-social-button-background-hover: var(--aw-color-theme-primary);
    --aw-body-text-color: var(--aw-color-theme-text);
    --aw-headline-color: var(--aw-color-theme-text);
    --aw-border-color: black;
    --aw-border-thickness: 3px;

    ::selection {
      background-color: var(--aw-color-theme-primary);
      color: white;
    }
  }

</style>
