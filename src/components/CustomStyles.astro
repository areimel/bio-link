---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Press Start 2P';
    --aw-font-mono: 'Courier Prime';

    /* Semantic theme colors (preserving VHS color values) */
    --aw-color-theme-secondary: #f7d959; /* Bright secondary accent */
    --aw-color-theme-primary: #f18344; /* Main primary action color */
    --aw-color-theme-accent: #da3440; /* Vibrant accent/highlight */
    --aw-color-theme-accent-alt: #af375d; /* Alternative accent */
    --aw-color-theme-surface: #f2e2c8; /* Surface background */
    --aw-color-theme-text: rgb(68, 68, 68); /* Main text color */

    /* Main theme colors using semantic theme palette */
    --aw-color-primary: var(--aw-color-theme-accent);
    --aw-color-secondary: var(--aw-color-theme-secondary);
    --aw-color-accent: var(--aw-color-theme-accent-alt);
    
    --aw-color-text-heading: rgb(68, 68, 68); /* Dark gray from VHS logo */
    --aw-color-text-default: rgb(56, 56, 56);
    --aw-color-text-muted: rgb(56, 56, 56 / 66%);
    --aw-color-bg-page: #f2e2c8; /* Off-white from VHS box */

    --aw-color-bg-page-dark: rgb(3 6 32);

    ::selection {
      background-color: var(--aw-color-accent);
      color: white;
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Press Start 2P';
    --aw-font-mono: 'Courier Prime';

    /* Dark mode - using the same theme colors but with adjusted opacity/usage */
    --aw-color-theme-secondary: #f7d959;
    --aw-color-theme-primary: #f18344;
    --aw-color-theme-accent: #da3440;
    --aw-color-theme-accent-alt: #af375d;
    --aw-color-theme-surface: rgb(24, 26, 42);
    --aw-color-theme-text: rgb(247, 248, 248);

    /* Main theme colors for dark mode */
    --aw-color-primary: var(--aw-color-theme-accent);
    --aw-color-secondary: var(--aw-color-theme-secondary);
    --aw-color-accent: var(--aw-color-theme-accent-alt);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(24, 26, 42); /* Darker but with a hint of blue */

    ::selection {
      background-color: var(--aw-color-accent);
      color: white;
    }
  }

  /* Custom class for Press Start 2P font */
  .press-start-2p-regular {
    font-family: "Press Start 2P", system-ui;
    font-weight: 400;
    font-style: normal;
  }
</style>
